# =================================================================
# ARCANUM INFORMATION TECHNOLOGY - BACKEND & SERVICE CONFIGURATION
# =================================================================

# -----------------------------------------------------------------
# FIREBASE BACKEND CONFIGURATION
# Copy these credentials from your Firebase Console Project Settings
# -----------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# -----------------------------------------------------------------
# NODEMAILER SMTP NOTIFICATION SERVICE CONFIGURATION
# -----------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@arcanum.ae
SMTP_PASS=your_app_password_here
SMTP_FROM="Arcanum IT Backend <info@arcanum.ae>"

# Receiver Email Address for Technical Inquiries & Quotes
NOTIFICATION_RECEIVER_EMAIL=info@arcanum.ae
